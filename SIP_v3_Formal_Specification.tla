---------------- MODULE SIP_v3_Formal_Specification ----------------\n\nEXTENDS Integers, FiniteSets, Bags\n\n(*\n--algorithm sip_v3\nvariables\n  institutions = {\"InstA\", \"InstB\", \"InstC\"}, \* A set of participating financial institutions.\n  roots = {\"Root1\", \"Root2\"},           \* A set of designated GIEN Root nodes.\n  messages = <<>>,\n  node_logs = [i \\in institutions |-> <<>>],\n  root_sths = [r \\in roots |-> [tree_hash |-> 0, stage |-> \"committed\", proposed_hash |-> 0]], \* stage can be committed, prepared\n  network_state = \"Stable\";\n\ndefine\n  TypeOK ==\n    /\\ institutions \\subseteq STRING\n    /\\ roots \\subseteq STRING\n    /\\ messages \\in Seq(STRING)\n    /\\ node_logs \\in [institutions -> Seq(STRING)]\n    /\\ root_sths \\in [roots -> [tree_hash: Int, stage: {\"committed\", \"prepared\"}, proposed_hash: Int]]\n    /\\ network_state \\in {\"Stable\", \"DivergenceDetected\", \"AwaitingQuorum\", \"ProtocolError\"}\nend define;\n\nprocess GossipAttestation = 1\n  variable inst \\in institutions;\n  begin\n    SendAttestation:\n      messages := Append(messages, \"attestation_\" \\o ToString(inst));\nend process;\n\nprocess ReceiveAttestation = 2\n  variable inst \\in institutions, msg \\in messages;\n  begin\n    ProcessAttestation:\n      if \"attestation_\" \\o ToString(inst) = msg then\n        node_logs[inst] := Append(node_logs[inst], msg);\n      end if;\nend process;\n\nprocess TwoPhaseCommit = 3 \* Replaces ProposeSTH and SignSTH\n  variable r \\in roots, log_hash \\in DOMAIN node_logs;\n  begin\n    Prepare:\n      if root_sths[r].stage = \"committed\" then\n        root_sths[r].proposed_hash := hash(node_logs[log_hash]);\n        root_sths[r].stage := \"prepared\";\n      end if;\n\n    Commit:\n      if root_sths[r].stage = \"prepared\" /\\ \\forall r2 \\in roots : root_sths[r2].stage = \"prepared\" /\\ root_sths[r].proposed_hash = root_sths[r2].proposed_hash then\n        root_sths[r].tree_hash := root_sths[r].proposed_hash;\n        root_sths[r].stage := \"committed\";\n      end if;\n  end process;\n\nprocess CheckDivergence = 4\n  begin\n    DetectDivergence:\n      if \\exists i, j \\in institutions : node_logs[i] /= node_logs[j] then\n        network_state := \"DivergenceDetected\";\n      else\n        network_state := \"Stable\";\n      end if;\nend process;\n\nend algorithm;\n*)\n\n\\* INVARIANTS\n\nTypeInv == TypeOK\n\nRootConvergence == \\A r1, r2 \\in roots : root_sths[r1].tree_hash = root_sths[r2].tree_hash\n\nNoSilentDivergence == \\A i, j \\in institutions : (node_logs[i] /= node_logs[j]) => (network_state = \"DivergenceDetected\")\n\n\\* LIVENESS\n\nEventuallyRootConvergence == <>(RootConvergence)\n\n=============================================================================