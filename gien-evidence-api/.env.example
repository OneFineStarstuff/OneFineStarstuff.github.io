# GIEN Evidence API local configuration template.
# Copy to .env only for local development. Values below are intentionally blank
# for credentials, so /readyz must remain NOT READY until each dependency is configured.
NODE_ENV=development
PORT=8080

# OIDC/OAuth2 introspection endpoint and server credentials.
GIEN_OIDC_CLIENT_ID=
GIEN_OIDC_CLIENT_SECRET=
GIEN_OIDC_INTROSPECTION_URL=http://127.0.0.1:8081/oauth2/introspect

# Tenant-scoped evidence snapshot adapter; must enforce X-GIEN-Tenant-ID.
GIEN_EVIDENCE_PROVIDER_TOKEN=
GIEN_EVIDENCE_PROVIDER_URL=http://127.0.0.1:8082/v1/systemic-risk

# Durable audit receiver. It must verify X-GIEN-Audit-Signature, persist the event
# append-only, implement idempotency on Idempotency-Key, and issue a receipt only
# after successful persistence.
GIEN_AUDIT_SINK_HMAC_SECRET=
GIEN_AUDIT_SINK_URL=http://127.0.0.1:8083/v1/events

# Exact browser origins, comma-separated. Do not use *.
GIEN_ALLOWED_ORIGINS=http://localhost:4173

# Optional bounds: upstream timeout 500-10000 ms, snapshot age 1000-900000 ms.
GIEN_MAX_SNAPSHOT_AGE_MS=300000
GIEN_UPSTREAM_TIMEOUT_MS=3000
