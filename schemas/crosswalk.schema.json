{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gien-crosswalk.schema.json",
  "title": "GIEN compliance crosswalk (B7, WP-114)",
  "type": "object",
  "required": [
    "version",
    "catalog_rev",
    "regimes"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "catalog_rev": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "regimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "real",
          "controls"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "real": {
            "type": "boolean"
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "oscal",
                "opa",
                "evidence"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z0-9-]+$"
                },
                "title": {
                  "type": "string",
                  "minLength": 3
                },
                "oscal": {
                  "type": "string",
                  "pattern": "^oscal-[a-z0-9.-]+$"
                },
                "opa": {
                  "enum": [
                    "enforced",
                    "advisory"
                  ]
                },
                "evidence": {
                  "type": "string"
                }
              }
            }
          },
          "fiction_note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
